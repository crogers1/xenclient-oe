--- a/configure
+++ b/configure
@@ -382,6 +382,8 @@ default_devices="true"
 # 3. Automatically enable/disable other options
 tcg="enabled"
 cfi="false"
+sdlabi="1.2"
+readonly_ide="no"
 
 # 4. Detection partly done in configure
 xen=${default_feature:+disabled}
@@ -1178,6 +1180,10 @@ for opt do
   ;;
   --disable-rng-none) rng_none=no
   ;;
+  --disable-readonly-ide) readonly_ide="no"
+  ;;
+  --enable-readonly-ide) readonly_ide="yes"
+  ;;
   --enable-keyring) secret_keyring="yes"
   ;;
   --disable-keyring) secret_keyring="no"
@@ -3807,6 +3813,9 @@ echo "CONFIG_QEMU_INTERP_PREFIX=$interp_
 if test "$default_targets" = "yes"; then
   echo "CONFIG_DEFAULT_TARGETS=y" >> $config_host_mak
 fi
+if test "$readonly_ide" = "yes" ; then
+  echo "CONFIG_READONLY_IDE=y" >> $config_host_mak
+fi
 
 if test "$numa" = "yes"; then
   echo "CONFIG_NUMA=y" >> $config_host_mak
--- a/hw/ide/core.c
+++ b/hw/ide/core.c
@@ -1488,6 +1488,13 @@ static bool cmd_write_multiple(IDEState
         return true;
     }
 
+#ifdef CONFIG_READONLY_IDE
+    if (!blk_supports_write_perm(s->blk)) {
+        ide_abort_command(s);
+        return true;
+    }
+#endif
+
     ide_cmd_lba48_transform(s, lba48);
 
     s->req_nb_sectors = s->mult_sectors;
@@ -1532,6 +1539,13 @@ static bool cmd_write_pio(IDEState *s, u
         return true;
     }
 
+#ifdef CONFIG_READONLY_IDE
+    if (!blk_supports_write_perm(s->blk)) {
+        ide_abort_command(s);
+        return true;
+    }
+#endif
+
     ide_cmd_lba48_transform(s, lba48);
 
     s->req_nb_sectors = 1;
@@ -1567,6 +1581,13 @@ static bool cmd_write_dma(IDEState *s, u
         return true;
     }
 
+#ifdef CONFIG_READONLY_IDE
+    if (!blk_supports_write_perm(s->blk)) {
+        ide_abort_command(s);
+        return true;
+    }
+#endif
+
     ide_cmd_lba48_transform(s, lba48);
     ide_sector_start_dma(s, IDE_DMA_WRITE);
 
@@ -2541,10 +2562,12 @@ int ide_init_drive(IDEState *s, BlockBac
             error_setg(errp, "Device needs media, but drive is empty");
             return -1;
         }
+#ifndef CONFIG_READONLY_IDE
         if (!blk_is_writable(blk)) {
             error_setg(errp, "Can't use a read-only drive");
             return -1;
         }
+#endif
         blk_set_dev_ops(blk, &ide_hd_block_ops, s);
     }
     if (serial) {
--- a/hw/ide/qdev.c
+++ b/hw/ide/qdev.c
@@ -203,7 +203,12 @@ static void ide_dev_initfn(IDEDevice *de
             return;
         }
     }
-    if (!blkconf_apply_backend_options(&dev->conf, kind == IDE_CD,
+    /* OpenXT: We also support read-only disks */
+    bool readonly = kind == IDE_CD;
+#ifdef CONFIG_READONLY_IDE
+    readonly |= !blk_supports_write_perm(dev->conf.blk);
+#endif
+    if (!blkconf_apply_backend_options(&dev->conf, readonly,
                                        kind != IDE_CD, errp)) {
         return;
     }
