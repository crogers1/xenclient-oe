################################################################################
REMOVAL 
################################################################################
Upstream it.

################################################################################
UPSTREAM PLAN
################################################################################
Submit to linux-wireless, if they are interested in the MSI case.  Not sure if
this is the _right_ way to handle this particular case, but it was effective.
Ultimately linux-wireless devs would know best if it is NOT ok to re-enable the 
RF_KILL interrupt before the PNVM is loaded.

################################################################################
INTERNAL DEPENDENCIES 
################################################################################
None.

################################################################################
PATCHES 
################################################################################

--- a/drivers/net/wireless/intel/iwlwifi/mvm/fw.c
+++ b/drivers/net/wireless/intel/iwlwifi/mvm/fw.c
@@ -334,6 +334,15 @@ static int iwl_mvm_load_ucode_wait_alive
 		return -EIO;
 	}
 
+	/* 
+	 * re-enable interrupts so we can get a response from
+	 * the card when kicking the doorbell during pnvm load.
+	 * This is only needed in the non-msix case. FW is
+	 * technically alive at this point so re-enabling rf-kill
+	 * interrupt is probably ok.
+	 */
+	iwl_trans_interrupts(mvm->trans, true);
+
 	ret = iwl_pnvm_load(mvm->trans, &mvm->notif_wait);
 	if (ret) {
 		IWL_ERR(mvm, "Timeout waiting for PNVM load!\n");
