########################################
## <summary>
##	Connect to ivcdaemon over a unix stream socket.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`ivcd_stream_connect',`
	gen_require(`
		type ivcd_t, ivcd_runtime_t;
	')

	files_search_runtime($1)
	stream_connect_pattern($1, ivcd_runtime_t, ivcd_runtime_t, ivcd_t)
')
