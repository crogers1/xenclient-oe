#OpenXT:
#	This patch enables auto dhcp on eth0 and brbridged which is disabled by default.
#	auto dhcp is disabled by default on eth0 as it is a slave to brbridged.
#	auto dhcp is disabled by default on bridge devices.
--- a/src/core/devices/nm-device.c
+++ b/src/core/devices/nm-device.c
@@ -11583,8 +11583,11 @@ activate_stage3_ip_config_for_addr_famil
     NMDeviceClass   *klass   = NM_DEVICE_GET_CLASS(self);
     NMConnection    *connection;
     int              ip_ifindex;
+    const char      *iface = NULL;
 
-    if (nm_device_sys_iface_state_is_external(self))
+    iface = nm_device_get_ip_iface(self);
+
+    if (nm_device_sys_iface_state_is_external(self) && (strncmp (iface, "brbridged", 9)))
         goto out;
 
     connection = nm_device_get_applied_connection(self);
@@ -15331,6 +15334,7 @@ _set_state_full(NMDevice *self, NMDevice
     NMSettingsConnection         *sett_conn;
     NMSettingSriov               *s_sriov;
     gboolean                      concheck_now;
+    char *iface = NULL;
 
     g_return_if_fail(NM_IS_DEVICE(self));
 
@@ -15387,8 +15391,10 @@ _set_state_full(NMDevice *self, NMDevice
     /* Cache the activation request for the dispatcher */
     req = nm_g_object_ref(priv->act_request.obj);
 
+    iface = nm_device_get_ip_iface (self);
     if (state > NM_DEVICE_STATE_UNMANAGED && state <= NM_DEVICE_STATE_ACTIVATED
-        && nm_device_state_reason_check(reason) == NM_DEVICE_STATE_REASON_NOW_MANAGED
+        && (nm_device_state_reason_check(reason) == NM_DEVICE_STATE_REASON_NOW_MANAGED
+        || !strncmp (iface, "brbridged", 9))
         && NM_IN_SET_TYPED(NMDeviceSysIfaceState,
                            priv->sys_iface_state,
                            NM_DEVICE_SYS_IFACE_STATE_EXTERNAL,
--- a/src/core/NetworkManagerUtils.c
+++ b/src/core/NetworkManagerUtils.c
@@ -1675,7 +1675,7 @@ nm_utils_platform_capture_ip_setting(NMP
     if (ifindex <= 0 || !nm_platform_link_get(platform, ifindex)) {
         g_object_set(s_ip,
                      NM_SETTING_IP_CONFIG_METHOD,
-                     IS_IPv4 ? NM_SETTING_IP4_CONFIG_METHOD_DISABLED
+                     IS_IPv4 ? NM_SETTING_IP4_CONFIG_METHOD_AUTO
                              : NM_SETTING_IP6_CONFIG_METHOD_IGNORE,
                      NULL);
         return NM_SETTING(g_steal_pointer(&s_ip));
@@ -1728,7 +1728,7 @@ nm_utils_platform_capture_ip_setting(NMP
     if (!method) {
         /* Use 'disabled/ignore' if the method wasn't previously set */
         if (IS_IPv4)
-            method = NM_SETTING_IP4_CONFIG_METHOD_DISABLED;
+            method = NM_SETTING_IP4_CONFIG_METHOD_AUTO;
         else
             method = maybe_ipv6_disabled ? NM_SETTING_IP6_CONFIG_METHOD_DISABLED
                                          : NM_SETTING_IP6_CONFIG_METHOD_IGNORE;
